# Database Configuration
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=codesentinel
POSTGRES_PORT=5433
POSTGRES_HOST=localhost

# Prisma Database Connection URL
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/codesentinel?schema=public"

# NestJS Server & CORS
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000

# GitHub OAuth 2.0 Credentials (Never expose to browser)
# Obtain these from: GitHub Settings -> Developer settings -> OAuth Apps
GITHUB_CLIENT_ID=your_github_oauth_client_id_here
GITHUB_CLIENT_SECRET=your_github_oauth_client_secret_here
GITHUB_CALLBACK_URL=http://localhost:4000/auth/github/callback

# Session Token Signing Key (Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))")
JWT_SECRET=your_secure_random_jwt_secret_at_least_32_characters_here

# Google Gemini AI Provider Configuration (Backend-only, never expose to frontend)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# Optional: AI Request Timeout (ms) and Max Source Code Length (characters)
AI_TIMEOUT_MS=35000
MAX_SOURCE_CODE_LENGTH=65536

# Rate Limiting Configuration
RATE_LIMIT_MAX=20
RATE_LIMIT_WINDOW_MS=60000
